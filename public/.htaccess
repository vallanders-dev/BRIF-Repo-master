# =========================================================================
# British & French Academy — Apache config for OVH shared hosting
# Place this file in your web root (alongside the built site).
# =========================================================================

# Use the custom 404 page
ErrorDocument 404 /404.html

# Redirect the bare domain root to the English site
# (index.html already does this via meta-refresh; this is a faster fallback)
RewriteEngine On
RewriteBase /

# Force HTTPS (recommended once your SSL certificate is active on OVH)
# Uncomment the next two lines after enabling SSL:
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Serve pretty directory URLs (Astro builds folder/index.html)
DirectoryIndex index.html

# --- Caching for static assets (faster repeat visits) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# --- Basic security headers ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
