---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/content.js';
import { localizedPath, alternatePath } from '../i18n/ui.js';

const {
  lang = 'en',
  routeKey = 'home',
  title,
  description = '',
} = Astro.props;

const fullTitle = title
  ? `${title} · ${site.shortName}`
  : `${site.name} · ${site.motto}`;

const canonical = new URL(localizedPath(lang, routeKey), Astro.site).href;
const altLang = lang === 'en' ? 'fr' : 'en';
const altHref = new URL(alternatePath(lang, routeKey), Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={altLang} href={altHref} />
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('en', routeKey), Astro.site).href} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />

    <!-- Fonts: Fraunces (display) + Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta name="theme-color" content="#132340" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon-180.png" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div id="fb-root"></div>
    <Header lang={lang} routeKey={routeKey} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script src="/scripts/interactions.js" defer></script>
    <!-- Facebook SDK: powers the Page Plugin on the News page.
         Loads asynchronously and only affects .fb-page elements. -->
    <script>
      (function (d, s, id) {
        if (d.getElementById(id)) return;
        var js = d.createElement(s);
        js.id = id;
        // @ts-ignore — d.createElement(s) is always a <script> tag here (see call at bottom)
        js.src = 'https://connect.facebook.net/' +
          (document.documentElement.lang === 'fr' ? 'fr_FR' : 'en_GB') +
          '/sdk.js#xfbml=1&version=v19.0';
        var fjs = d.getElementsByTagName(s)[0];
        fjs.parentNode.insertBefore(js, fjs);
      })(document, 'script', 'facebook-jssdk');
    </script>
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main { flex: 1; }
</style>
