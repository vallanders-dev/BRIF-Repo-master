---
import Base from '../layouts/Base.astro';
import { content } from '../data/content.js';
import { localizedPath } from '../i18n/ui.js';
// Default to English for the 404; it links back to both homes.
const lang = 'en';
const c = content[lang].notFound;
const enHome = localizedPath('en', 'home');
const frHome = localizedPath('fr', 'home');
---
<Base lang={lang} routeKey="home" title={c.title} description={c.text}>
  <section class="nf">
    <div class="wrap nf-inner">
      <p class="nf-code" aria-hidden="true">4<span class="nf-0">0</span>4</p>
      <h1>{c.title}</h1>
      <p class="nf-text">{c.text}</p>
      <div class="nf-actions">
        <a href={enHome} class="btn">{c.button}</a>
        <a href={frHome} class="btn btn--ghost">Version française</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    background: var(--oxford);
    color: #fff;
    min-height: 70vh;
    display: grid;
    place-items: center;
    text-align: center;
    padding-block: 4rem;
  }
  .nf-code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 3rem + 12vw, 11rem);
    font-weight: 600;
    line-height: 1;
    color: #fff;
  }
  .nf-0 { color: var(--yellow); }
  .nf h1 { color: #fff; font-size: var(--step-3); margin: 1rem 0 0.8rem; }
  .nf-text { color: #c6d2e6; max-width: 44ch; margin: 0 auto 2rem; }
  .nf-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .nf .btn--ghost { color: #fff; border-color: rgba(255,255,255,0.5); }
  .nf .btn--ghost:hover { background: #fff; color: var(--oxford); border-color: #fff; }
</style>
