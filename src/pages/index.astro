---
// Root path: redirect to the default language.
// Uses a meta-refresh so it works on static hosts like OVH without server config.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <link rel="canonical" href="/en/" />
    <title>British & French Academy</title>
  </head>
  <body>
    <p>Redirecting to <a href="/en/">British &amp; French Academy</a>…</p>
  </body>
</html>
