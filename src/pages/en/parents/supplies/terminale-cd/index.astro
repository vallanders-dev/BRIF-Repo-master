import ParentsSuppliesClassPage from '../../../../../components/ParentsSuppliesClassPage.astro';
import { supplyLists } from '../../../../../data/content.js';
const lang = 'en';
const listKey = 'terminale-cd';
const list = supplyLists.find((l) => l.key === listKey);
---
<Base lang={lang} routeKey="suppliesTerminaleCd" title={list.classLabel} description="School supply list for Terminale CD at British & French Academy.">
  <ParentsSuppliesClassPage lang={lang} listKey={listKey} />
</Base>
