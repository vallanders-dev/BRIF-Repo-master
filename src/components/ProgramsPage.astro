---
import { Image } from 'astro:assets';
import { content } from '../data/content.js';
import PageHero from './PageHero.astro';
import { localizedPath } from '../i18n/ui.js';
import earlyYearsPhoto from '../assets/photos/brif-early-years-desk.jpg';
import primaryPhoto from '../assets/photos/brif-primary-hallway.jpg';
import lowerSecondaryPhoto from '../assets/photos/brif-basketball-play.jpg';
import upperSecondaryPhoto from '../assets/photos/brif-graduate-portrait.jpg';

const { lang = 'en' } = Astro.props;
const c = content[lang].programs;
const enrolHref = localizedPath(lang, 'enrol');

// Positional match to c.items (Early Years, Primary School, Lower Secondary,
// Upper Secondary) — same pattern as LifePage.astro's highlightImages.
const itemPhotos = [earlyYearsPhoto, primaryPhoto, lowerSecondaryPhoto, upperSecondaryPhoto];
---
<PageHero lang={lang} kicker={c.kicker} title={c.title} routeKey="programs" />

<section class="section">
  <div class="wrap">
    <p class="lede intro-lede" data-reveal>{c.intro}</p>
    <div class="prog-grid">
      {c.items.map((item, i) => (
        <article class="prog-card" data-reveal class:list={[`d${i + 1}`]}>
          <div class="prog-card-img">
            <Image src={itemPhotos[i]} alt={item.title} width={600} widths={[400, 600, 900]} sizes="(max-width: 640px) 100vw, 400px" loading="lazy" />
          </div>
          <div class="prog-card-body">
            <span class="prog-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            {item.more && (
              <button type="button" class="read-more-btn" data-modal-open={`prog-modal-${i}`}>
                {c.readMoreLabel}<span class="arw" aria-hidden="true">→</span>
              </button>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

{c.items.map((item, i) => item.more && (
  <div class="modal-backdrop" id={`prog-modal-${i}`} data-modal-backdrop hidden>
    <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby={`prog-modal-${i}-title`}>
      <button type="button" class="modal-close" data-modal-close aria-label={c.closeLabel}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
      <h3 id={`prog-modal-${i}-title`}>{item.title}</h3>
      {item.more.map((para) => <p>{para}</p>)}
    </div>
  </div>
))}

<section class="section section--mist">
  <div class="wrap prog-cta" data-reveal>
    <h2>{lang === 'fr' ? 'Une place pour votre enfant ?' : 'A place for your child?'}</h2>
    <a href={enrolHref} class="btn">{lang === 'fr' ? 'Demander une inscription' : 'Make an enquiry'}<span class="arw" aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .intro-lede { max-width: 60ch; margin-bottom: 3rem; }
  .prog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
  }
  .prog-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .prog-card::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--true-blue);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.25s ease;
    z-index: 1;
  }
  .prog-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: transparent; }
  .prog-card:hover::before { transform: scaleY(1); }
  .prog-card-img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--mist);
  }
  .prog-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .prog-card:hover .prog-card-img img { transform: scale(1.05); }
  .prog-card-body {
    padding: 1.7rem 1.7rem 2rem;
  }
  .prog-num {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    color: var(--true-blue);
    display: block;
    margin-bottom: 0.5rem;
  }
  .prog-card h3 { font-size: 1.4rem; margin-bottom: 0.5rem; }
  .prog-card p {
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.6;
    text-align: justify;
    text-justify: inter-word;
    hyphens: none;
  }
  @media (max-width: 640px) {
    .prog-card p { text-align: left; }
  }

  .read-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.9rem;
    background: none;
    border: none;
    padding: 0;
    color: var(--true-blue);
    font-weight: 600;
    font-size: 0.92rem;
    cursor: pointer;
  }
  .read-more-btn:hover { color: var(--orange); }
  .read-more-btn .arw { transition: transform 0.2s ease; }
  .read-more-btn:hover .arw { transform: translateX(3px); }

  /* Read-more modal */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(10, 18, 36, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    z-index: 200;
  }
  .modal-backdrop[hidden] { display: none; }
  .modal-box {
    position: relative;
    background: var(--paper);
    border-radius: var(--radius);
    max-width: 640px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    padding: 2.4rem 2.2rem 2.2rem;
    box-shadow: 0 30px 60px -15px rgba(0,0,0,0.5);
  }
  .modal-box h3 {
    font-size: 1.5rem;
    margin-bottom: 1.2rem;
    padding-right: 1.5rem;
  }
  .modal-box p {
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.7;
    margin-bottom: 1.1rem;
  }
  .modal-box p:last-child { margin-bottom: 0; }
  .modal-close {
    position: absolute;
    top: 1.2rem; right: 1.2rem;
    width: 36px; height: 36px;
    display: grid;
    place-items: center;
    background: var(--mist);
    border: none;
    border-radius: 50%;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .modal-close:hover { background: var(--orange); color: #fff; }

  .prog-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .prog-cta h2 { font-size: var(--step-3); }

  @media (max-width: 640px) { .prog-grid { grid-template-columns: 1fr; } }
</style>
