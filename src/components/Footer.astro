---
import { useTranslations, localizedPath } from '../i18n/ui.js';
import { site } from '../data/content.js';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const quickLinks = ['about', 'programs', 'life', 'news'].map((key) => ({
  label: t(`nav.${key}`),
  href: localizedPath(lang, key),
}));
const moreLinks = ['admissions', 'contact'].map((key) => ({
  label: t(`nav.${key}`),
  href: localizedPath(lang, key),
}));
const legalLinks = [
  { key: 'privacy', label: t('footer.privacy') },
  { key: 'legal', label: t('footer.legal') },
  { key: 'cookies', label: t('footer.cookies') },
].map((l) => ({ label: l.label, href: localizedPath(lang, l.key) }));
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <img
        src="/images/cambridge-international-white.png"
        alt="Cambridge International Education"
        class="footer-logo"
        width="300"
        height="131"
        loading="lazy"
      />
      <p class="footer-tagline">{t('footer.tagline')}</p>
      <div class="footer-social">
        <a href={site.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="footer-social-link">
          <svg viewBox="0 0 48 48" width="34" height="34" aria-hidden="true">
            <rect x="1" y="1" width="46" height="46" rx="14" fill="#1877F2"></rect>
            <path d="M27 16h4v-5h-4c-3.3 0-6 2.7-6 6v3h-3v5h3v11h5V25h4l1-5h-5v-3c0-.6.4-1 1-1z" fill="#fff"></path>
          </svg>
        </a>
        <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="footer-social-link">
          <svg viewBox="0 0 48 48" width="34" height="34" aria-hidden="true">
            <defs>
              <linearGradient id="igGradFooter" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#FEE411"></stop>
                <stop offset="15%" stop-color="#FEDA77"></stop>
                <stop offset="30%" stop-color="#F58529"></stop>
                <stop offset="50%" stop-color="#DD2A7B"></stop>
                <stop offset="70%" stop-color="#8134AF"></stop>
                <stop offset="100%" stop-color="#515BD4"></stop>
              </linearGradient>
            </defs>
            <rect x="1" y="1" width="46" height="46" rx="14" fill="url(#igGradFooter)"></rect>
            <rect x="13" y="13" width="22" height="22" rx="6" fill="none" stroke="#fff" stroke-width="2"></rect>
            <circle cx="24" cy="24" r="6" fill="none" stroke="#fff" stroke-width="2"></circle>
            <circle cx="31.5" cy="16.5" r="1.4" fill="#fff"></circle>
          </svg>
        </a>
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp" class="footer-social-link">
          <svg viewBox="0 0 48 48" width="34" height="34" aria-hidden="true">
            <rect x="1" y="1" width="46" height="46" rx="14" fill="#25D366"></rect>
            <path d="M24 12c-6.6 0-12 5.4-12 12 0 2.1.6 4.2 1.6 6L12 36l6.2-1.6c1.7.9 3.7 1.4 5.8 1.4 6.6 0 12-5.4 12-12s-5.4-12-12-12zm0 2c5.5 0 10 4.5 10 10s-4.5 10-10 10c-1.9 0-3.7-.5-5.3-1.5l-.4-.2-3.7 1 1-3.6-.2-.4C14.5 27.7 14 25.9 14 24c0-5.5 4.5-10 10-10zm-3.3 5.2c-.2 0-.5 0-.7.3-.3.3-1 1-1 2.3 0 1.4 1 2.7 1.2 2.9.1.2 2 3.2 5 4.4 2.5 1 3 .8 3.5.8.6 0 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.3-.6-.4l-2-1c-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-2-1.8-2.3-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.4.3-.6.1-.2 0-.4 0-.6-.1-.2-.7-1.8-1-2.4-.3-.6-.5-.5-.7-.5z" fill="#fff"></path>
          </svg>
        </a>
      </div>
    </div>

    <nav class="footer-col" aria-label={t('footer.quicklinks')}>
      <h3>{t('footer.quicklinks')}</h3>
      <ul>
        {quickLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-label={t('nav.admissions')}>
      <h3>{t('nav.admissions')}</h3>
      <ul>
        {moreLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-col">
      <h3>{t('footer.contact')}</h3>
      <ul class="footer-contact">
        <li>{site.address[lang]}</li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`tel:${site.phonePrimary.replace(/\s+/g, '')}`}>{site.phonePrimary}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-base">
    <div class="wrap footer-base-inner">
      <p>© {year} {site.name}. {t('footer.rights')}</p>
      <nav class="footer-legal" aria-label={t('footer.legal')}>
        {legalLinks.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a href={l.href}>{l.label}</a>
          </>
        ))}
      </nav>
      <p class="footer-since">Since {site.since} · {site.city}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--oxford-deep);
    color: #b9c4d8;
    margin-top: auto;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
    gap: 2.5rem;
    padding-block: clamp(3rem, 2rem + 3vw, 4.5rem);
  }
  .footer-brand .footer-logo {
    height: 46px;
    width: auto;
    margin-bottom: 1.3rem;
    opacity: 0.95;
  }
  .footer-tagline { font-size: 0.92rem; max-width: 34ch; }
  .footer-social {
    display: flex;
    gap: 0.7rem;
    margin-top: 1.4rem;
  }
  .footer-social-link {
    display: block;
    line-height: 0;
    border-radius: 14px;
    transition: transform 0.2s ease;
  }
  .footer-social-link:hover { transform: translateY(-3px); }

  .footer-col h3 {
    color: #fff;
    font-size: 1.05rem;
    margin-bottom: 1rem;
  }
  .footer-col ul { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .footer-col a { color: #b9c4d8; font-size: 0.95rem; }
  .footer-col a:hover { color: var(--yellow); }
  .footer-contact li { font-size: 0.95rem; line-height: 1.5; }

  .footer-base {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding-block: 1.4rem;
  }
  .footer-base-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: #8b98b0;
  }
  .footer-since { color: var(--yellow); }
  .footer-legal a { color: #8b98b0; }
  .footer-legal a:hover { color: var(--yellow); }

  @media (max-width: 820px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
