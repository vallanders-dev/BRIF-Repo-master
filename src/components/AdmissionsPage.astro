---
import { content } from '../data/content.js';
import PageHero from './PageHero.astro';
import { localizedPath } from '../i18n/ui.js';

const { lang = 'en' } = Astro.props;
const c = content[lang].admissions;
const enrolHref = localizedPath(lang, 'enrol');
const contactHref = localizedPath(lang, 'contact');
---
<PageHero lang={lang} kicker={c.kicker} title={c.title} routeKey="admissions" />

<section class="section">
  <div class="wrap">
    <p class="lede intro-lede" data-reveal>{c.intro}</p>

    <div class="section-head" data-reveal>
      <p class="eyebrow">{c.stepsTitle}</p>
      <h2>{c.stepsTitle}</h2>
    </div>
    <div class="steps">
      {c.steps.map((s, i) => (
        <article class="step" data-reveal class:list={[`d${Math.min(i + 1, 4)}`]}>
          <span class="step-n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section section--mist">
  <div class="wrap faq-wrap">
    <div class="section-head center-head" data-reveal>
      <p class="eyebrow">{c.faqTitle}</p>
      <h2>{c.faqTitle}</h2>
    </div>
    <div class="accordion" data-accordion data-reveal>
      {c.faqs.map((f, i) => (
        <div class={`acc-item${i === 0 ? ' is-open' : ''}`}>
          <button class="acc-q" aria-expanded={i === 0 ? 'true' : 'false'}>
            <span>{f.q}</span>
            <span class="acc-icon" aria-hidden="true"></span>
          </button>
          <div class="acc-a">
            <div class="acc-a-inner">{f.a}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section cta-band">
  <div class="wrap cta-inner" data-reveal>
    <h2>{c.ctaText}</h2>
    <div class="cta-actions">
      <a href={enrolHref} class="btn btn--yellow">{c.ctaButton}<span class="arw" aria-hidden="true">→</span></a>
      <a href={contactHref} class="btn btn--ghost btn--on-dark">{content[lang].contact.title}</a>
    </div>
  </div>
</section>

<style>
  .intro-lede { max-width: 60ch; margin-bottom: 3rem; }
  .section-head { margin-bottom: 2.5rem; }
  .section-head h2 { font-size: var(--step-3); }
  .center-head { text-align: center; }
  .center-head .eyebrow { justify-content: center; }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.4rem;
  }
  .step {
    padding: 1.8rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .step:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .step-n {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 600;
    color: var(--yellow);
    -webkit-text-stroke: 1px var(--true-blue);
    display: block;
    margin-bottom: 0.5rem;
    line-height: 1;
  }
  .step h3 { font-size: 1.3rem; margin-bottom: 0.4rem; }
  .step p { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.6; }

  .faq-wrap { max-width: 820px; }

  .cta-band { background: linear-gradient(120deg, var(--oxford), var(--true-blue-ink)); color: #fff; }
  .cta-inner { text-align: center; }
  .cta-inner h2 { color: #fff; font-size: var(--step-3); margin-bottom: 1.5rem; }
  .cta-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 860px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .steps { grid-template-columns: 1fr; } }
</style>
