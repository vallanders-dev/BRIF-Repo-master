---
import { Image } from 'astro:assets';
import { content, uniforms } from '../data/content.js';
import PageHero from './PageHero.astro';
import { localizedPath } from '../i18n/ui.js';

import dailyShirtShortsRender from '../assets/photos/uniforms/daily-shirt-shorts-render.png';
import dailyPinaforeRender from '../assets/photos/uniforms/daily-pinafore-render.png';
import sportsTshirtShortsRender from '../assets/photos/uniforms/sports-tshirt-shorts-render.png';
import sportsJerseyShortsRender from '../assets/photos/uniforms/sports-jersey-shorts-render.png';

// Keyed by outfit.key rather than stored on the outfit object in content.js,
// so content.js stays data-only — see the comment above `uniforms` there.
const renderByKey = {
  'daily-shirt-shorts': dailyShirtShortsRender,
  'daily-pinafore': dailyPinaforeRender,
  'sports-tshirt-shorts': sportsTshirtShortsRender,
  'sports-jersey-shorts': sportsJerseyShortsRender,
};

const { lang = 'en' } = Astro.props;
const c = content[lang].uniformPage;
const parentsHref = localizedPath(lang, 'parents');
---
<PageHero lang={lang} kicker={c.kicker} title={c.title} routeKey="parentsUniform" />

<section class="section">
  <div class="wrap uniform-wrap">
    <p class="lede intro-lede" data-reveal>{c.intro}</p>

    {uniforms.map((outfit) => {
      const render = renderByKey[outfit.key];
      return (
      <article class="outfit" data-reveal>
        <div class="outfit-head">
          <span class="outfit-category">{c.categoryLabels[outfit.category]}</span>
          <h2>{outfit.label[lang]}</h2>
        </div>

        <div class="outfit-media" data-outfit-media>
          <div class="callout-col callout-col--left">
            {outfit.callouts.map((callout, i) => i % 2 === 0 && (
              <div class="callout-label" data-dot-index={i} data-side="left">
                <span class="callout-label-num">{i + 1}</span>
                <div>
                  <strong>{callout.label[lang]}</strong>
                  <p>{callout.detail[lang]}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="render-stage">
            <div class="render-frame" data-render-frame>
              {render ? (
                <button type="button" class="render-trigger" data-zoom-trigger aria-label={c.zoomLabel}>
                  <Image
                    src={render}
                    alt={outfit.renderAlt[lang]}
                    width={640}
                    widths={[320, 480, 640, 800]}
                    sizes="(max-width: 700px) 90vw, 420px"
                    loading="lazy"
                  />
                </button>
              ) : (
                <div class="render-placeholder">
                  <span>{c.renderPlaceholder}</span>
                </div>
              )}

              {outfit.callouts.map((callout, i) => (
                <button
                  type="button"
                  class="callout-dot"
                  style={`left:${callout.x}%; top:${callout.y}%;`}
                  aria-label={`${i + 1}. ${callout.label[lang]}: ${callout.detail[lang]}`}
                >
                  <span aria-hidden="true">{i + 1}</span>
                </button>
              ))}
            </div>
            <svg class="leader-svg" data-leader-svg aria-hidden="true"></svg>
            <p class="media-caption">{c.renderLabel}</p>
          </div>

          <div class="callout-col callout-col--right">
            {outfit.callouts.map((callout, i) => i % 2 === 1 && (
              <div class="callout-label" data-dot-index={i} data-side="right">
                <span class="callout-label-num">{i + 1}</span>
                <div>
                  <strong>{callout.label[lang]}</strong>
                  <p>{callout.detail[lang]}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <h3 class="sr-only">{c.calloutsListLabel}</h3>
        <ol class="callout-list-mobile">
          {outfit.callouts.map((callout, i) => (
            <li>
              <span class="callout-label-num">{i + 1}</span>
              <div>
                <strong>{callout.label[lang]}</strong>
                <p>{callout.detail[lang]}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="real-photos">
          <p class="media-caption">{c.realPhotoLabel}</p>
          {outfit.realPhotos.length > 0 ? (
            <div class="real-photos-grid">
              {outfit.realPhotos.map((photo) => (
                <Image
                  src={photo.image}
                  alt={photo.alt[lang]}
                  width={360}
                  widths={[240, 360, 480]}
                  sizes="(max-width: 700px) 45vw, 220px"
                  loading="lazy"
                />
              ))}
            </div>
          ) : (
            <p class="media-placeholder-text">{c.photosPlaceholder}</p>
          )}
        </div>

        <div class="outfit-items">
          <h3>{c.itemsHeading}</h3>
          <ul>
            {outfit.items.map((item) => (
              <li>
                <strong>{item.name[lang]}</strong>
                <span>{item.note[lang]}</span>
              </li>
            ))}
          </ul>
        </div>
      </article>
      );
    })}

    <a href={parentsHref} class="btn btn--ghost back-link">
      <span class="arw arw--back" aria-hidden="true">←</span>{c.backToParents}
    </a>
  </div>
</section>

<div class="zoom-overlay" data-zoom-overlay hidden>
  <button type="button" class="zoom-close" data-zoom-close aria-label={c.zoomCloseLabel}>
    <span aria-hidden="true">×</span>
  </button>
  <img data-zoom-image alt="" />
</div>

<script>
  const MEDIA_QUERY = '(min-width: 700px)';

  function layoutLeaderLines(mediaEl) {
    const svg = mediaEl.querySelector('[data-leader-svg]');
    const frame = mediaEl.querySelector('[data-render-frame]');
    if (!svg || !frame) return;

    if (!window.matchMedia(MEDIA_QUERY).matches) {
      svg.innerHTML = '';
      return;
    }

    const containerRect = mediaEl.getBoundingClientRect();
    svg.setAttribute('width', String(containerRect.width));
    svg.setAttribute('height', String(containerRect.height));
    svg.setAttribute('viewBox', `0 0 ${containerRect.width} ${containerRect.height}`);
    svg.innerHTML = '';

    const dots = frame.querySelectorAll('.callout-dot');
    dots.forEach((dot, i) => {
      const label = mediaEl.querySelector(`.callout-label[data-dot-index="${i}"]`);
      if (!label) return;
      const dotRect = dot.getBoundingClientRect();
      const labelRect = label.getBoundingClientRect();
      const side = label.dataset.side;

      const x1 = dotRect.left + dotRect.width / 2 - containerRect.left;
      const y1 = dotRect.top + dotRect.height / 2 - containerRect.top;
      const x2 = (side === 'left' ? labelRect.right : labelRect.left) - containerRect.left;
      const y2 = labelRect.top + labelRect.height / 2 - containerRect.top;

      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('x1', String(x1));
      line.setAttribute('y1', String(y1));
      line.setAttribute('x2', String(x2));
      line.setAttribute('y2', String(y2));
      line.setAttribute('class', 'leader-line');
      svg.appendChild(line);
    });
  }

  function init() {
    const mediaBlocks = document.querySelectorAll('[data-outfit-media]');
    if (!mediaBlocks.length) return;

    const relayoutAll = () => mediaBlocks.forEach((el) => layoutLeaderLines(el));

    // ResizeObserver catches image load, web-font swap reflow, and viewport
    // resize/orientation change in one place, without separate listeners
    // for each — any of those change a label card's size or position.
    const ro = new ResizeObserver(() => relayoutAll());
    mediaBlocks.forEach((el) => ro.observe(el));
    window.addEventListener('resize', relayoutAll);
    relayoutAll();

    // ---- Zoom lightbox ---------------------------------------------------
    const overlay = document.querySelector('[data-zoom-overlay]');
    const overlayImg = overlay?.querySelector('[data-zoom-image]');
    const closeBtn = overlay?.querySelector('[data-zoom-close]');
    let lastTrigger = null;

    function openZoom(trigger) {
      const img = trigger.querySelector('img');
      if (!overlay || !overlayImg || !img) return;
      overlayImg.src = img.currentSrc || img.src;
      overlayImg.alt = img.alt;
      lastTrigger = trigger;
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }
    function closeZoom() {
      if (!overlay) return;
      overlay.hidden = true;
      document.body.style.overflow = '';
      lastTrigger?.focus();
    }

    document.querySelectorAll('[data-zoom-trigger]').forEach((btn) => {
      btn.addEventListener('click', () => openZoom(btn));
    });
    closeBtn?.addEventListener('click', closeZoom);
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) closeZoom();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay && !overlay.hidden) closeZoom();
    });
  }

  init();
</script>

<style>
  .uniform-wrap { max-width: 1100px; }
  .intro-lede { max-width: 70ch; margin-bottom: 3rem; }
  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }

  .outfit { margin-bottom: 4.5rem; }
  .outfit-head { margin-bottom: 1.6rem; }
  .outfit-category {
    display: inline-block;
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    color: var(--orange);
    margin-bottom: 0.4rem;
  }
  .outfit-head h2 { font-size: var(--step-2); }

  /* ---- Media block: side label columns + render + leader lines -------- */
  .outfit-media {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 420px) minmax(0, 1fr);
    gap: 1.4rem;
    align-items: start;
    margin-bottom: 1.4rem;
  }
  .callout-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.2rem;
  }
  .callout-col--left { align-items: flex-end; }
  .callout-col--right { align-items: flex-start; }
  .callout-col--left .callout-label { text-align: right; flex-direction: row-reverse; }

  .callout-label {
    display: flex;
    gap: 0.6rem;
    max-width: 240px;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
  }
  .callout-label strong { display: block; color: var(--oxford); font-size: 0.92rem; }
  .callout-label p { color: var(--ink-soft); font-size: 0.82rem; line-height: 1.5; margin-top: 0.2rem; }
  .callout-label-num {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px; height: 20px;
    border-radius: 50%;
    background: var(--oxford);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .render-stage { display: flex; flex-direction: column; gap: 0.6rem; }
  .render-frame {
    position: relative;
    /* Fixed 4:5 — the widest of the four supplied renders (0.8) fills it
       edge to edge; the taller ones (0.6–0.667) letterbox on the sides only
       (object-fit: contain never crops), so a slightly-off future render
       degrades to letterboxing instead of cropping the garment or shifting
       the layout. */
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--mist);
    overflow: hidden;
  }
  .render-trigger {
    display: block;
    width: 100%; height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .render-trigger :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .render-placeholder {
    width: 100%; height: 100%;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    text-align: center;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .callout-dot {
    position: absolute;
    width: 22px; height: 22px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--oxford);
    border: 2px solid var(--yellow);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    display: grid;
    place-items: center;
    cursor: default;
    z-index: 2;
  }
  .callout-dot:hover,
  .callout-dot:focus-visible { background: var(--true-blue); }

  .leader-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  /* :global — this <line> is created client-side (JS), so it never gets
     Astro's scoping attribute and a plain .leader-line rule would silently
     never match it. */
  :global(.leader-line) { stroke: var(--oxford); stroke-width: 1.5; opacity: 0.55; }

  .media-caption {
    text-align: center;
    color: var(--ink-soft);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .callout-list-mobile { display: none; }

  .real-photos { margin-top: 2.2rem; }
  .real-photos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1rem;
    margin-top: 0.6rem;
  }
  .real-photos-grid :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
  }
  .media-placeholder-text {
    margin-top: 0.6rem;
    color: var(--ink-soft);
    font-size: 0.88rem;
    font-style: italic;
    text-align: center;
  }

  .outfit-items { margin-top: 2.2rem; }
  .outfit-items h3 { font-size: 1.1rem; margin-bottom: 0.8rem; }
  .outfit-items ul { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .outfit-items li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
  }
  .outfit-items li strong { color: var(--oxford); flex: none; }
  .outfit-items li span { color: var(--ink-soft); text-align: right; }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .arw--back { transition: transform 0.2s ease; }
  .back-link:hover .arw--back { transform: translateX(-3px); }

  /* ---- Below 700px: collapse the side columns into a numbered list ---- */
  @media (max-width: 700px) {
    .outfit-media { grid-template-columns: minmax(0, 1fr); }
    .callout-col { display: none; }
    .leader-svg { display: none; }
    .render-frame { max-width: 420px; margin-inline: auto; width: 100%; }

    .callout-list-mobile {
      display: grid;
      gap: 0.8rem;
      list-style: none;
      padding: 0;
      margin-top: 1.2rem;
    }
    .callout-list-mobile li {
      display: flex;
      gap: 0.7rem;
      padding: 0.7rem 0.9rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
    }
    .callout-list-mobile strong { display: block; color: var(--oxford); font-size: 0.92rem; }
    .callout-list-mobile p { color: var(--ink-soft); font-size: 0.85rem; line-height: 1.5; margin-top: 0.2rem; }

    .outfit-items li { flex-direction: column; gap: 0.2rem; }
    .outfit-items li span { text-align: left; }
  }

  /* ---- Zoom lightbox ---------------------------------------------------- */
  .zoom-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(13, 26, 48, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  .zoom-overlay[hidden] { display: none; }
  .zoom-overlay img {
    max-width: min(92vw, 900px);
    max-height: 88vh;
    width: auto;
    height: auto;
    border-radius: var(--radius-sm);
    box-shadow: 0 30px 80px -20px rgba(0,0,0,0.6);
  }
  .zoom-close {
    position: absolute;
    top: 1.2rem;
    right: 1.4rem;
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,0.4);
    background: rgba(255,255,255,0.08);
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.16s ease;
  }
  .zoom-close:hover { background: rgba(255,255,255,0.18); }

  @media (prefers-reduced-motion: reduce) {
    .callout-dot, .zoom-close { transition: none; }
  }
</style>
