---
import { Image } from 'astro:assets';
import { site } from '../data/content.js';
import { localizedPath, useTranslations } from '../i18n/ui.js';

const { lang = 'en', kicker, title, routeKey, image, imagePosition = 'center 30%' } = Astro.props;
const t = useTranslations(lang);
const homeHref = localizedPath(lang, 'home');
---
<section class="page-hero" class:list={[{ 'page-hero--photo': !!image }]}>
  <div class="page-hero-bg" aria-hidden="true">
    {image && (
      <>
        <Image src={image} alt="" class="ph-photo" style={`object-position: ${imagePosition}`} width={1200} widths={[480, 768, 1200]} sizes="100vw" format="webp" quality={80} loading="eager" />
        <span class="ph-scrim"></span>
      </>
    )}
    <span class="ph-orb"></span>
    <span class="ph-grid"></span>
  </div>
  <div class="wrap">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href={homeHref}>{t('nav.home')}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>
    {kicker && <p class="page-hero-kicker">{kicker}</p>}
    <h1>{title}</h1>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    background: var(--oxford);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
  }
  .page-hero-bg { position: absolute; inset: 0; z-index: -1; }
  .page-hero--photo { padding-block: clamp(4rem, 3rem + 6vw, 6.5rem); }
  .ph-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .ph-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(19,35,64,0.94) 0%, rgba(19,35,64,0.85) 45%, rgba(19,35,64,0.55) 100%);
  }
  .ph-orb {
    position: absolute;
    width: 380px; height: 380px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(57,108,180,0.5), transparent 70%);
    top: -140px; right: -60px;
    filter: blur(12px);
  }
  .ph-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse at 70% 40%, #000 20%, transparent 70%);
    mask-image: radial-gradient(ellipse at 70% 40%, #000 20%, transparent 70%);
  }
  .crumb {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-size: 0.85rem;
    color: #9fb0cc;
    margin-bottom: 1.2rem;
  }
  .crumb a { color: #9fb0cc; }
  .crumb a:hover { color: var(--yellow); }
  .crumb [aria-current] { color: #fff; }
  .page-hero-kicker {
    color: var(--yellow);
    font-weight: 600;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    font-size: 0.78rem;
    margin-bottom: 0.8rem;
  }
  .page-hero h1 {
    color: #fff;
    font-size: clamp(2.2rem, 1.6rem + 3vw, 3.6rem);
    font-weight: 600;
  }
</style>
