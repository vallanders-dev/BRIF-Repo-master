---
import { useTranslations, localizedPath, alternatePath } from '../i18n/ui.js';
import { site } from '../data/content.js';

const { lang = 'en', routeKey = 'home' } = Astro.props;
const t = useTranslations(lang);

const navKeys = ['home', 'programs', 'admissions', 'life', 'news', 'about', 'contact'];
const nav = navKeys.map((key) => ({
  key,
  label: t(`nav.${key}`),
  href: localizedPath(lang, key),
}));

const homeHref = localizedPath(lang, 'home');
// Both language paths for the current page, for the EN|FR pill.
const enHref = localizedPath('en', routeKey);
const frHref = localizedPath('fr', routeKey);
const applyHref = localizedPath(lang, 'admissions');
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href={homeHref} class="brand" aria-label={site.name}>
      <img src="/images/logo.png" alt={site.name} class="brand-logo" width="171" height="160" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <label for="nav-toggle" class="nav-burger" aria-label="Menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.key === routeKey ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="nav-actions">
        <div class="lang-pill" role="group" aria-label="Language / Langue">
          <a href={enHref} aria-current={lang === 'en' ? 'true' : undefined} hreflang="en">EN</a>
          <a href={frHref} aria-current={lang === 'fr' ? 'true' : undefined} hreflang="fr">FR</a>
        </div>
        <a href={applyHref} class="btn btn--sm">
          <span class="btn-label">{t('nav.apply')}</span>
          <span class="btn-arrow-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
          </span>
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--oxford);
    color: #fff;
    border-bottom: 3px solid var(--yellow);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 86px;
  }

  /* Brand */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: #fff;
  }
  .brand:hover { color: #fff; }
  .brand-logo {
    height: 62px;
    width: auto;
    flex: none;
    transition: transform 0.2s ease;
  }
  .brand:hover .brand-logo { transform: scale(1.03); }
  /* Nav */
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }
  .site-nav ul {
    display: flex;
    gap: 1.4rem;
    list-style: none;
    padding: 0;
  }
  .site-nav a {
    color: #d7e0ef;
    font-weight: 500;
    font-size: 0.98rem;
    padding: 0.4rem 0;
    position: relative;
  }
  .site-nav ul a::after {
    content: "";
    position: absolute;
    left: 0; bottom: -2px;
    width: 0; height: 2px;
    background: var(--yellow);
    transition: width 0.2s ease;
  }
  .site-nav ul a:hover,
  .site-nav ul a[aria-current="page"] { color: #fff; }
  .site-nav ul a:hover::after,
  .site-nav ul a[aria-current="page"]::after { width: 100%; }

  .nav-actions { display: flex; align-items: center; gap: 0.9rem; }

  .btn.btn--sm {
    padding: 0.8rem 1.3rem 0.8rem 2.3rem;
    gap: 1rem;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    border-radius: 999px;
    box-shadow: 0 12px 26px -8px rgba(0,0,0,0.6);
  }
  .btn.btn--sm:hover {
    box-shadow: 0 16px 32px -8px rgba(0,0,0,0.65);
  }
  .btn-label { white-space: nowrap; }
  .btn-arrow-badge {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #fff;
    color: var(--orange);
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
  }
  /* Scale in place on hover rather than sliding toward the edge — keeps the
     badge clear of the pill's border regardless of how tight the padding is. */
  .btn.btn--sm:hover .btn-arrow-badge {
    transform: scale(1.1);
    background: var(--yellow);
    color: var(--oxford);
  }

  /* Burger (mobile) */
  .nav-toggle, .nav-burger { display: none; }
  .nav-burger {
    width: 44px; height: 44px;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
  }
  .nav-burger span {
    display: block;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  @media (max-width: 940px) {
    .nav-burger { display: flex; }
    .site-nav {
      position: absolute;
      top: 100%; left: 0; right: 0;
      background: var(--oxford-deep);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem var(--gutter) 1.5rem;
      border-bottom: 3px solid var(--yellow);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }
    .nav-toggle:checked ~ .site-nav { max-height: 80vh; }
    .site-nav ul {
      flex-direction: column;
      gap: 0;
    }
    .site-nav ul li { border-bottom: 1px solid rgba(255,255,255,0.08); }
    .site-nav ul a { display: block; padding: 0.9rem 0; }
    .nav-actions {
      margin-top: 1.2rem;
      justify-content: flex-start;
    }
    .nav-toggle:checked ~ .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle:checked ~ .nav-burger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>
