---
import { useTranslations, localizedPath, alternatePath } from '../i18n/ui.js';
import { site } from '../data/content.js';

const { lang = 'en', routeKey = 'home' } = Astro.props;
const t = useTranslations(lang);

const navKeys = ['home', 'programs', 'admissions', 'life', 'news', 'about', 'contact'];
const nav = navKeys.map((key) => ({
  key,
  label: t(`nav.${key}`),
  href: localizedPath(lang, key),
}));

const homeHref = localizedPath(lang, 'home');
// Both language paths for the current page, for the EN|FR pill.
const enHref = localizedPath('en', routeKey);
const frHref = localizedPath('fr', routeKey);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href={homeHref} class="brand" aria-label={site.name}>
      <img src="/images/logo.png" alt={site.name} class="brand-logo" width="171" height="160" />
      <span class="brand-name">{site.name}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <label for="nav-toggle" class="nav-burger" aria-label="Menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.key === routeKey ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="nav-actions">
        <img
          src="/images/cambridge-international-white.png"
          alt="Cambridge International Education"
          class="partner-logo"
          width="300"
          height="131"
          loading="lazy"
        />
        <div class="lang-pill" role="group" aria-label="Language / Langue">
          <a href={enHref} aria-current={lang === 'en' ? 'true' : undefined} hreflang="en">EN</a>
          <a href={frHref} aria-current={lang === 'fr' ? 'true' : undefined} hreflang="fr">FR</a>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--oxford);
    color: #fff;
    border-bottom: 3px solid var(--yellow);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 86px;
  }

  /* Brand */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: #fff;
  }
  .brand:hover { color: #fff; }
  .brand-logo {
    height: 62px;
    width: auto;
    flex: none;
    transition: transform 0.2s ease;
  }
  .brand:hover .brand-logo { transform: scale(1.03); }
  .brand-name {
    font-family: 'Bricolage Grotesque', var(--font-body);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.2;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    max-width: 12ch;
  }

  /* Partner logo */
  .partner-logo {
    height: 40px;
    width: auto;
    flex: none;
    opacity: 0.95;
  }

  /* Nav */
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }
  .site-nav ul {
    display: flex;
    gap: 1.4rem;
    list-style: none;
    padding: 0;
  }
  .site-nav a {
    color: #d7e0ef;
    font-weight: 500;
    font-size: 0.98rem;
    padding: 0.4rem 0;
    position: relative;
  }
  .site-nav ul a::after {
    content: "";
    position: absolute;
    left: 0; bottom: -2px;
    width: 0; height: 2px;
    background: var(--yellow);
    transition: width 0.2s ease;
  }
  .site-nav ul a:hover,
  .site-nav ul a[aria-current="page"] { color: #fff; }
  .site-nav ul a:hover::after,
  .site-nav ul a[aria-current="page"]::after { width: 100%; }

  .nav-actions { display: flex; align-items: center; gap: 0.9rem; }

  /* Burger (mobile) */
  .nav-toggle, .nav-burger { display: none; }
  .nav-burger {
    width: 44px; height: 44px;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
  }
  .nav-burger span {
    display: block;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  @media (max-width: 560px) {
    .brand-name { display: none; }
  }

  @media (max-width: 940px) {
    .nav-burger { display: flex; }
    .site-nav {
      position: absolute;
      top: 100%; left: 0; right: 0;
      background: var(--oxford-deep);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem var(--gutter) 1.5rem;
      border-bottom: 3px solid var(--yellow);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }
    .nav-toggle:checked ~ .site-nav { max-height: 80vh; }
    .site-nav ul {
      flex-direction: column;
      gap: 0;
    }
    .site-nav ul li { border-bottom: 1px solid rgba(255,255,255,0.08); }
    .site-nav ul a { display: block; padding: 0.9rem 0; }
    .nav-actions {
      margin-top: 1.2rem;
      justify-content: flex-start;
    }
    .nav-toggle:checked ~ .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle:checked ~ .nav-burger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>
