---
import { useTranslations, localizedPath, alternatePath } from '../i18n/ui.js';
import { site } from '../data/content.js';

const { lang = 'en', routeKey = 'home' } = Astro.props;
const t = useTranslations(lang);

const navKeys = ['home', 'programs', 'admissions', 'life', 'news', 'about', 'contact'];
const nav = navKeys.map((key) => ({
  key,
  label: t(`nav.${key}`),
  href: localizedPath(lang, key),
}));

const programsSubmenuKeys = ['programs', 'programsClassic', 'programsCambridge', 'programsImi'];
const programsSubmenu = programsSubmenuKeys.map((key) => ({
  key,
  label: key === 'programs' ? t('nav.programsOverview') : t(`nav.${key}`),
  href: localizedPath(lang, key),
}));
const programsRouteKeys = new Set(programsSubmenuKeys);

const homeHref = localizedPath(lang, 'home');
// Both language paths for the current page, for the EN|FR pill.
const enHref = localizedPath('en', routeKey);
const frHref = localizedPath('fr', routeKey);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href={homeHref} class="brand" aria-label={site.name}>
      <img src="/images/logo.png" alt={site.name} class="brand-logo" width="171" height="160" />
      <span class="brand-name">{site.name}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <label for="nav-toggle" class="nav-burger" aria-label="Menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          item.key === 'programs' ? (
            <li class="has-dropdown">
              <a
                href={item.href}
                aria-current={programsRouteKeys.has(routeKey) ? 'page' : undefined}
              >{item.label}</a>
              <div class="dropdown">
                <ul class="dropdown-inner">
                  {programsSubmenu.map((sub) => (
                    <li>
                      <a href={sub.href} aria-current={sub.key === routeKey ? 'page' : undefined}>{sub.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={item.key === routeKey ? 'page' : undefined}
              >{item.label}</a>
            </li>
          )
        ))}
      </ul>
      <div class="nav-actions">
        <div class="lang-pill" role="group" aria-label="Language / Langue">
          <a href={enHref} aria-current={lang === 'en' ? 'true' : undefined} hreflang="en">EN</a>
          <a href={frHref} aria-current={lang === 'fr' ? 'true' : undefined} hreflang="fr">FR</a>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--oxford);
    color: #fff;
    border-bottom: 3px solid var(--yellow);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 86px;
  }

  /* Brand */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: #fff;
  }
  .brand:hover { color: #fff; }
  .brand-logo {
    height: 62px;
    width: auto;
    flex: none;
    transition: transform 0.2s ease;
  }
  .brand:hover .brand-logo { transform: scale(1.03); }
  .brand-name {
    font-family: 'Bricolage Grotesque', var(--font-body);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.2;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    max-width: 12ch;
  }

  /* Nav */
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }
  .site-nav ul {
    display: flex;
    gap: 1.4rem;
    list-style: none;
    padding: 0;
  }
  .site-nav a {
    color: #d7e0ef;
    font-weight: 500;
    font-size: 0.98rem;
    padding: 0.4rem 0;
    position: relative;
  }
  .site-nav ul a::after {
    content: "";
    position: absolute;
    left: 0; bottom: -2px;
    width: 0; height: 2px;
    background: var(--yellow);
    transition: width 0.2s ease;
  }
  .site-nav ul a:hover,
  .site-nav ul a[aria-current="page"] { color: #fff; }
  .site-nav ul a:hover::after,
  .site-nav ul a[aria-current="page"]::after { width: 100%; }

  /* Programmes dropdown */
  .has-dropdown { position: relative; }
  .has-dropdown > a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .has-dropdown > a::before {
    content: "";
    width: 6px; height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    order: 2;
    opacity: 0.7;
  }
  .dropdown {
    position: absolute;
    top: 100%; left: 50%;
    /* Zero vertical offset in both states — a gap here breaks hover as the
       cursor crosses from the link down into the menu. Padding-top instead
       of margin keeps a hoverable bridge without a visible gap. */
    transform: translateX(-50%);
    padding-top: 0.6rem;
    min-width: 260px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.18s ease;
    z-index: 10;
  }
  .dropdown-inner {
    background: var(--oxford-deep);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius-sm);
    box-shadow: 0 20px 40px -12px rgba(0,0,0,0.5);
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    margin: 0;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .dropdown li { width: 100%; }
  .dropdown a {
    display: block;
    padding: 0.7rem 0.9rem;
    border-radius: 6px;
    font-size: 0.92rem;
    white-space: nowrap;
  }
  .dropdown a:hover,
  .dropdown a[aria-current="page"] {
    background: rgba(255,255,255,0.06);
    color: #fff;
  }
  .dropdown a::after { display: none; }

  .nav-actions { display: flex; align-items: center; gap: 0.9rem; }

  /* Burger (mobile) */
  .nav-toggle, .nav-burger { display: none; }
  .nav-burger {
    width: 44px; height: 44px;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
  }
  .nav-burger span {
    display: block;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  @media (max-width: 560px) {
    .brand-name { display: none; }
  }

  @media (max-width: 940px) {
    .nav-burger { display: flex; }
    .site-nav {
      position: absolute;
      top: 100%; left: 0; right: 0;
      background: var(--oxford-deep);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      /* No padding/border while collapsed — max-height:0 only stops content
         from showing, it never shrinks padding or border below their set
         size, so a padded, bordered box at max-height:0 still renders at
         padding+border height, leaking the first nav link into view. */
      padding: 0 var(--gutter);
      border-bottom: 0 solid var(--yellow);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease, padding 0.3s ease, border-bottom-width 0.3s ease;
    }
    .nav-toggle:checked ~ .site-nav {
      max-height: 80vh;
      /* auto, not hidden — on a short viewport the full link list plus the
         language pill can exceed 80vh; auto lets the panel scroll instead
         of silently clipping whatever comes last (the lang switcher). */
      overflow-y: auto;
      padding: 0.5rem var(--gutter) 1.5rem;
      border-bottom-width: 3px;
    }
    .site-nav ul {
      flex-direction: column;
      gap: 0;
    }
    .site-nav ul li { border-bottom: 1px solid rgba(255,255,255,0.08); }
    .site-nav ul a { display: block; padding: 0.9rem 0; }
    .has-dropdown > a::before { transform: rotate(45deg) translateY(-2px); }
    .dropdown {
      position: static;
      transform: none;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      min-width: 0;
      padding: 0;
    }
    .dropdown-inner {
      background: transparent;
      border: none;
      box-shadow: none;
      padding: 0 0 0.5rem 1rem;
    }
    .dropdown li { border-bottom: none; }
    .dropdown a { padding: 0.6rem 0; color: #aebbd4; }
    .nav-actions {
      /* Placed first, above the link list, so it's visible the instant the
         menu opens rather than requiring a scroll to the bottom to find it. */
      order: -1;
      justify-content: flex-start;
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .nav-toggle:checked ~ .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle:checked ~ .nav-burger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>
