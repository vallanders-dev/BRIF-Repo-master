---
import { Image } from 'astro:assets';
import { content, news, site } from '../data/content.js';
import PageHero from './PageHero.astro';
import igcseResultsPhoto from '../assets/photos/brif-igcse-100-percent.jpg';
import septemberWishesPhoto from '../assets/photos/brif-september-wishes.jpg';
import schoolResumptionPhoto from '../assets/photos/brif-school-resumption.jpg';
import summerSchoolPhoto from '../assets/photos/brif-swimming-pool.jpg';

const { lang = 'en' } = Astro.props;
const c = content[lang].news;
const fb = content[lang].fbModule;
const items = news[lang];

// Thumbnails, keyed the same way as UniformPage.astro's renders — see the
// comment above `news` in content.js for which items still need a real photo.
// Every entry here is a dedicated image used nowhere else on the site — do
// not point a key at a photo that's already imported elsewhere (e.g.
// ProgramsPage.astro, LifePage.astro).
const thumbByKey = {
  'igcse-results': igcseResultsPhoto,
  'september-wishes': septemberWishesPhoto,
  'school-resumption': schoolResumptionPhoto,
  'summer-school': summerSchoolPhoto,
};

const dateFmt = (iso) => {
  // Parse as local-timezone date components, not a UTC instant — new Date(iso)
  // on a date-only string parses as UTC midnight, which can render as the
  // previous day for any viewer west of UTC.
  const [y, m, d] = iso.split('-').map(Number);
  return new Date(y, m - 1, d).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-GB', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
};
---
<PageHero lang={lang} kicker={c.kicker} title={c.title} routeKey="news" />

<section class="section">
  <div class="wrap">
    <p class="lede intro-lede" data-reveal>{c.intro}</p>
    <div class="news-list">
      {items.map((n, i) => {
        const thumb = thumbByKey[n.key];
        return (
        <article class="news-item" data-reveal class:list={[`d${Math.min(i + 1, 4)}`]}>
          {thumb ? (
            <div class="news-item-img">
              <Image src={thumb} alt="" width={300} height={225} widths={[240, 300, 450]} sizes="(max-width: 860px) 100vw, 300px" loading="lazy" />
            </div>
          ) : (
            <div class="news-item-img news-item-img--placeholder" aria-hidden="true"><span>📷</span></div>
          )}
          <div class="news-item-body">
            <time datetime={n.date}>{dateFmt(n.date)}</time>
            <h2>{n.title}</h2>
            <p>{n.subtitle}</p>
          </div>
        </article>
        );
      })}
    </div>
  </div>
</section>

<!-- Facebook follow CTA. Used to also embed Facebook's official Page Plugin
     (a cross-origin iframe) alongside this, but that widget's own internal
     styling — fonts, colours, post cards — can't be restyled via CSS (it's
     sandboxed, and Meta's platform terms forbid disguising it), and it
     looked visually inconsistent with the rest of the site. Dropped in
     favour of this standalone, fully on-brand CTA. -->
<section class="section section--mist">
  <div class="wrap fb-live" data-reveal>
    <p class="eyebrow">{fb.kicker}</p>
    <h2>{fb.title}</h2>
    <p class="lede">{fb.text}</p>
    <a href={site.facebook} class="btn" target="_blank" rel="noopener">
      <span class="fb-icon" aria-hidden="true">f</span>{fb.button}
    </a>
  </div>
</section>

<style>
  .intro-lede { max-width: 60ch; margin-bottom: 3rem; }
  .news-list { display: grid; gap: 1.6rem; }
  .news-item {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 1.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .news-item:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .news-item-img {
    /* No aspect-ratio here on purpose: this box sits in a grid row next to
       the text column, whose content (title + subtitle) sets the row's
       height. A fixed aspect-ratio locks the box to its own height instead
       of stretching to match — leaving a gap below it whenever the text is
       taller. Absolutely positioning the img to fill via inset instead (same
       pattern as .life-card-img--photo in LifePage.astro) lets the box
       stretch with the row (grid's default) and the photo always covers it
       completely, whatever height that turns out to be. */
    position: relative;
    overflow: hidden;
  }
  .news-item-img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .news-item-img--placeholder {
    background: linear-gradient(135deg, var(--mist), #e8eef7);
    border-right: 1px dashed var(--true-blue);
    display: grid;
    place-items: center;
    font-size: 2rem;
    color: var(--true-blue);
  }
  .news-item-body { padding: 1.8rem 1.8rem 1.8rem 0; }
  .news-item-body time {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--true-blue);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .news-item-body h2 { font-size: 1.6rem; margin: 0.5rem 0 0.7rem; }
  .news-item-body p { color: var(--ink-soft); }

  .fb-live {
    max-width: 52ch;
    margin-inline: auto;
    text-align: center;
  }
  .fb-live .eyebrow { margin-bottom: 1rem; }
  .fb-live h2 { font-size: var(--step-3); margin-bottom: 1rem; }
  .fb-live .lede { margin-bottom: 1.6rem; }
  .fb-live .btn { display: inline-flex; }
  .fb-icon {
    display: inline-grid;
    place-items: center;
    width: 22px; height: 22px;
    background: #fff;
    color: var(--orange);
    border-radius: 5px;
    font-family: Georgia, serif;
    font-weight: bold;
    font-style: italic;
    font-size: 0.95rem;
  }

  @media (max-width: 860px) {
    .news-item { grid-template-columns: 1fr; }
    .news-item-img--placeholder { border-right: none; border-bottom: 1px dashed var(--true-blue); }
    .news-item-body { padding: 1.6rem; }
  }
</style>
