---
import { Image } from 'astro:assets';
import { content, canteenMenu } from '../data/content.js';
import PageHero from './PageHero.astro';
import { localizedPath } from '../i18n/ui.js';
import heroPhoto from '../assets/photos/brif-parents-event-table.jpg';
import canteenServicePhoto from '../assets/photos/brif-canteen-service.jpg';
import canteenPlate1 from '../assets/photos/brif-canteen-plate-01.png';
import canteenPlate2 from '../assets/photos/brif-canteen-plate-02.png';
import communityPhoto from '../assets/photos/brif-parents-gala-table.jpg';

const { lang = 'en' } = Astro.props;
const c = content[lang].parentsHub;
const calendarHref = localizedPath(lang, 'parentsCalendar');
const canteenPlates = [canteenPlate1, canteenPlate2];
---
<PageHero lang={lang} kicker={c.kicker} title={c.title} routeKey="parents" image={heroPhoto} />

<section class="section">
  <div class="wrap">
    <p class="lede intro-lede" data-reveal>{c.intro}</p>

    <figure class="community-photo" data-reveal>
      <Image src={communityPhoto} alt={c.communityPhotoAlt} width={1200} widths={[600, 900, 1200]} sizes="100vw" loading="lazy" />
      <figcaption>{c.communityPhotoCaption}</figcaption>
    </figure>

    <div class="section-head" data-reveal>
      <h2>{c.documentsTitle}</h2>
    </div>
    <div class="doc-grid">
      {c.documents.map((doc, i) => (
        <article class="doc-card" data-reveal class:list={[`d${Math.min(i + 1, 4)}`]}>
          <h3>{doc.title}</h3>
          <p>{doc.description}</p>
          {doc.status === 'available' && doc.href ? (
            <a href={doc.href} class="doc-link" {...(doc.external !== false ? { target: '_blank', rel: 'noopener' } : {})}>
              {doc.linkLabel ?? c.downloadLabel}<span class="arw" aria-hidden="true">→</span>
            </a>
          ) : (
            <span class="doc-badge">{c.comingSoonLabel}</span>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>{c.canteenTitle}</h2>
      <p class="canteen-intro">{c.canteenIntro}</p>
    </div>
    <div class="canteen-grid">
      <div class="canteen-photo canteen-photo--service" data-reveal>
        <Image src={canteenServicePhoto} alt={c.canteenPhotoAlts[0]} width={760} height={507} widths={[400, 600, 760]} sizes="(max-width: 780px) 100vw, 50vw" loading="lazy" />
      </div>
      <div class="canteen-plates">
        {canteenPlates.map((plate, i) => (
          <div class="canteen-photo canteen-photo--plate" data-reveal class:list={[`d${i + 2}`]}>
            <Image src={plate} alt={c.canteenPhotoAlts[i + 1]} width={360} height={300} widths={[240, 360]} sizes="(max-width: 780px) 50vw, 25vw" loading="lazy" />
          </div>
        ))}
      </div>
    </div>

    <div id="canteen-menu" class="menu-anchor"></div>
    <div class="section-head menu-head" data-reveal>
      <h3>{c.canteenMenuTitle}</h3>
    </div>
    <div class="menu-categories">
      {canteenMenu.map((cat) => (
        <div class="menu-category" data-reveal>
          <h4>{cat.label[lang]}</h4>
          {cat.items.length > 0 ? (
            <ul>
              {cat.items.map((item) => (
                <li>
                  {item.name}
                  {item.gloss?.[lang] && <span class="menu-gloss"> — {item.gloss[lang]}</span>}
                </li>
              ))}
            </ul>
          ) : (
            <p class="menu-empty">{c.canteenMenuEmptyNote}</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section section--mist">
  <div class="wrap calendar-teaser" data-reveal>
    <div>
      <p class="eyebrow">{c.calendarTeaserKicker}</p>
      <h2>{c.calendarTeaserTitle}</h2>
      <p>{c.calendarTeaserText}</p>
    </div>
    <a href={calendarHref} class="btn">{c.calendarTeaserButton}<span class="arw" aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .intro-lede { max-width: 60ch; margin-bottom: 3rem; }
  .section-head { margin-bottom: 2rem; }
  .section-head h2 { font-size: var(--step-3); }

  .community-photo {
    margin-bottom: 3rem;
  }
  .community-photo img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center 35%;
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    display: block;
  }
  .community-photo figcaption {
    margin-top: 0.7rem;
    color: var(--ink-soft);
    font-size: 0.88rem;
    text-align: center;
  }

  .doc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }
  .doc-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .doc-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .doc-card h3 { font-size: 1.15rem; }
  .doc-card p { color: var(--ink-soft); font-size: 0.92rem; line-height: 1.55; flex: 1; }

  .doc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
    color: var(--true-blue);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .doc-link:hover { color: var(--orange); }
  .doc-link .arw { transition: transform 0.2s ease; }
  .doc-link:hover .arw { transform: translateX(3px); }

  .doc-badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    margin-top: 0.4rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--mist);
    color: var(--ink-soft);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .calendar-teaser {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .calendar-teaser .eyebrow { margin-bottom: 0.6rem; }
  .calendar-teaser h2 { font-size: var(--step-3); margin-bottom: 0.6rem; }
  .calendar-teaser p:not(.eyebrow) { color: var(--ink-soft); max-width: 46ch; }

  .canteen-intro { color: var(--ink-soft); margin-top: 0.6rem; max-width: 60ch; }
  .canteen-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 1.4rem;
  }
  .canteen-plates {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
  }
  .canteen-photo {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .canteen-photo--service { aspect-ratio: 3 / 2; }
  .canteen-photo--service img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .canteen-photo--plate {
    aspect-ratio: 1 / 1;
    background: var(--mist);
    display: grid;
    place-items: center;
    padding: 0.8rem;
  }
  .canteen-photo--plate img { width: 100%; height: 100%; object-fit: contain; display: block; }

  .menu-anchor { scroll-margin-top: 100px; }
  .menu-head { margin-top: 3rem; }
  .menu-head h3 { font-size: var(--step-2); }

  /* Multi-column flow, not a grid: categories vary wildly in length (22
     mains vs. 0 for Pizzas), and a grid row stretches every card in that
     row to match its tallest sibling — the same issue fixed on the Student
     Life cards. Columns let each card size to its own content instead. */
  .menu-categories {
    columns: 3;
    column-gap: 1.4rem;
  }
  .menu-category {
    display: inline-block;
    width: 100%;
    break-inside: avoid;
    margin-bottom: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem;
  }
  .menu-category h4 {
    font-size: 1.05rem;
    margin-bottom: 0.8rem;
    color: var(--oxford);
  }
  .menu-category ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .menu-category li {
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .menu-gloss { color: var(--ink-soft); opacity: 0.75; font-style: italic; }
  .menu-empty {
    color: var(--ink-soft);
    font-size: 0.88rem;
    font-style: italic;
  }

  @media (max-width: 940px) { .doc-grid { grid-template-columns: repeat(2, 1fr); } .menu-categories { columns: 2; } }
  @media (max-width: 780px) { .canteen-grid { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .doc-grid { grid-template-columns: 1fr; } .menu-categories { columns: 1; } }
</style>
