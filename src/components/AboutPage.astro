---
import { content, site } from '../data/content.js';
import PageHero from './PageHero.astro';
import Cards from './Cards.astro';
import heroPhoto from '../assets/photos/brif-principal-certificate.jpg';

const { lang = 'en' } = Astro.props;
const c = content[lang].about;
---
<PageHero lang={lang} kicker={c.kicker} title={c.title} routeKey="about" image={heroPhoto} />

<!-- HISTORY -->
<section class="section">
  <div class="wrap prose-wrap">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{c.storyKicker}</p>
      <h2>{c.storyTitle}</h2>
    </div>
    <p class="lede" data-reveal>{c.intro}</p>
    {c.body.map((para, i) => (
      <p class="prose-p" data-reveal class:list={[`d${Math.min(i + 1, 4)}`]}>{para}</p>
    ))}
  </div>
</section>

<!-- VISION & MISSION -->
<section class="section section--mist">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{c.visionMissionKicker}</p>
      <h2>{c.visionMissionTitle}</h2>
    </div>
    <Cards items={c.visionMission} columns={2} />
  </div>
</section>

<!-- FOUNDERS -->
<section class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{c.foundersKicker}</p>
      <h2>{c.foundersTitle}</h2>
    </div>
    <div class="founders">
      {c.founders.map((f, i) => (
        <article class="founder-card" data-reveal class:list={[`d${Math.min(i + 1, 4)}`]}>
          <img src={f.photo} alt={f.name} class="founder-photo" width="96" height="96" loading="lazy" />
          <div class="founder-body">
            <h3>{f.name}</h3>
            <p class="founder-role">{f.role}</p>
            <p class="founder-bio">{f.bio}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- VALUES -->
<section class="section section--mist">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{c.valuesKicker}</p>
      <h2>{c.valuesTitle}</h2>
    </div>
    <Cards items={c.values} columns={4} />
  </div>
</section>

<!-- WHY BRIF -->
<section class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{c.whyKicker}</p>
      <h2>{c.whyTitle}</h2>
    </div>
    <Cards items={c.whyReasons} columns={4} />
  </div>
</section>

<!-- ACCREDITATIONS -->
<section id="accreditations" class="section section--mist">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{c.accreditationsKicker}</p>
      <h2>{c.accreditationsTitle}</h2>
    </div>
    <div class="accreditations-grid">
      {c.accreditations.map((a, i) => (
        <div class="accreditation-card" data-reveal class:list={[`d${i + 1}`]}>
          <span class="accreditation-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l7 3.5v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9v-5z"></path>
              <path d="M9 12.5l2 2 4-4.5"></path>
            </svg>
          </span>
          <h3>{a.title}</h3>
          <p>{a.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- PARTNERS -->
<section id="partners" class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{c.partnersKicker}</p>
      <h2>{c.partnersTitle}</h2>
      <p class="lede partners-intro">{c.partnersIntro}</p>
    </div>
    <div class="partners-grid">
      {c.partners.map((p, i) => (
        <div class="partner-card" data-reveal class:list={[`d${Math.min(i + 1, 4)}`]}>
          {p.logo
            ? <img src={p.logo} alt={p.name} class="partner-logo" loading="lazy" />
            : <div class="partner-logo-ph" aria-hidden="true"><span>🏫</span></div>
          }
          <p class="partner-name">{p.name}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- MOTTO FEATURE -->
<section class="section section--oxford motto-feature">
  <div class="wrap">
    <div class="motto-inner" data-reveal>
      <p class="eyebrow">{c.mottoTitle}</p>
      <p class="motto-big">{site.motto}</p>
      <p class="motto-gloss-lg">{site.mottoGloss[lang]}</p>
      <p class="motto-explain">{c.mottoText}</p>
    </div>
  </div>
</section>

<style>
  .prose-wrap { max-width: 72ch; }
  .prose-wrap .lede { margin-bottom: 1.8rem; }
  .prose-p {
    margin-bottom: 1.3rem;
    color: var(--ink);
    font-size: 1.08rem;
    line-height: 1.75;
    text-align: justify;
    text-justify: inter-word;
    hyphens: none;
  }
  .section-head { margin-bottom: 2.5rem; }
  .section-head h2 { font-size: var(--step-3); }

  .motto-feature { text-align: center; }
  .motto-inner { max-width: 60ch; margin-inline: auto; }
  .motto-inner .eyebrow { justify-content: center; margin-bottom: 1.5rem; }
  .motto-big {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(2.2rem, 1.6rem + 3vw, 3.4rem);
    color: var(--yellow);
    line-height: 1.1;
    margin-bottom: 0.6rem;
  }
  .motto-gloss-lg {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: #dfe6f2;
    margin-bottom: 1.8rem;
  }
  .motto-explain { color: #c6d2e6; line-height: 1.7; }

  .founders {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  .founder-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem;
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .founder-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .founder-photo {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
    border: 3px solid var(--mist);
  }
  .founder-body h3 { font-size: 1.25rem; margin-bottom: 0.2rem; }
  .founder-role {
    color: var(--orange);
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    margin-bottom: 0.7rem;
  }
  .founder-bio {
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.65;
    text-align: justify;
    text-justify: inter-word;
    hyphens: none;
  }

  @media (max-width: 780px) {
    .founders { grid-template-columns: 1fr; }
    .founder-card { flex-direction: column; align-items: center; text-align: center; }
    .founder-bio { text-align: left; }
  }

  /* Justified text reads poorly in narrow columns (big word gaps) — go left-aligned there. */
  @media (max-width: 640px) {
    .prose-p { text-align: left; }
  }

  .accreditations-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
  }
  .accreditation-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .accreditation-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .accreditation-badge {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--mist);
    color: var(--true-blue);
    margin-bottom: 1.1rem;
  }
  .accreditation-card h3 { font-size: 1.15rem; margin-bottom: 0.6rem; }
  .accreditation-card p {
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.7;
    text-align: justify;
    text-justify: inter-word;
    hyphens: none;
  }
  @media (max-width: 640px) {
    .accreditation-card p { text-align: left; }
  }

  @media (max-width: 780px) {
    .accreditations-grid { grid-template-columns: 1fr; }
  }

  .partners-intro { margin-top: 0.8rem; max-width: 60ch; }
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.4rem;
  }
  .partner-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    padding: 1.6rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-align: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .partner-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .partner-logo,
  .partner-logo-ph {
    width: 100%;
    aspect-ratio: 3 / 2;
    display: grid;
    place-items: center;
  }
  .partner-logo {
    background: var(--mist);
    border-radius: var(--radius-sm);
    padding: 0.9rem;
    object-fit: contain;
  }
  .partner-logo-ph {
    background: linear-gradient(135deg, var(--mist), #e8eef7);
    border: 1px dashed var(--true-blue);
    border-radius: var(--radius-sm);
    color: var(--true-blue);
    font-size: 1.6rem;
  }
  .partner-name { font-size: 0.85rem; color: var(--ink-soft); }

  @media (max-width: 860px) {
    .partners-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 540px) {
    .partners-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
